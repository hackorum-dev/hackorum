# processor side: where hackorum runs and the token the server's LINEAGE_API_TOKEN holds
LINEAGE_SERVER=http://localhost:3000
LINEAGE_API_TOKEN=

# never used by the processor, but the development environment refuses to boot without them
# any values of 32+ characters work, e.g. openssl rand -hex 32
RAILS_AR_ENCRYPTION_PRIMARY_KEY=
RAILS_AR_ENCRYPTION_DETERMINISTIC_KEY=
RAILS_AR_ENCRYPTION_SALT=
