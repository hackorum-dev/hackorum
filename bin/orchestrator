#!/usr/bin/env ruby
# frozen_string_literal: true

# The CI orchestrator: apply, push, ingest, forecast.
# See GITINTEGRATION and --help.

require "optparse"
require "fileutils"

# block buffering hides an hour of cycles behind nohup or tee
$stdout.sync = true

LOCK_KEY = "patch_ci_orchestrator"
# a daemon must survive a timeout; a broken config must not spin on it forever
MAX_CONSECUTIVE_FAILURES = 20

# the container healthcheck reads this file's mtime. GitRepo#run has no
# timeout, so a stalled fetch leaves a live process with a frozen cycle -
# the one death a restart policy cannot see.
HEARTBEAT_PATH = ENV.fetch("HACKORUM_ORCHESTRATOR_HEARTBEAT", "/tmp/orchestrator.heartbeat")

# the env defaults exist so an ad-hoc `docker compose run/exec ... bin/orchestrator`
# lands on the same repo as the daemon: that invocation replaces the compose
# command line, flags and all, and the bare defaults below point nowhere in a
# container. Same vars the entrypoint checks.
options = {
  repo: ENV["CI_REPO_DIR"] || File.expand_path("../postgres", __dir__),
  worktree: ENV["CI_WORKTREE_DIR"] || File.expand_path("../tmp/patch_ci_worktree", __dir__),
  remote: "origin",
  upstream_remote: "postgres",
  mirror_master: true,
  interval: 60
}

OptionParser.new do |o|
  o.banner = <<~BANNER
    Usage: bin/orchestrator [options]

    Needs HACKORUM_GITHUB_TOKEN in the environment:
      export HACKORUM_GITHUB_TOKEN=$(gh auth token)

    Options:
  BANNER
  o.on("--once", "run a single cycle and exit") { options[:once] = true }
  o.on("--dry-run", "compute and print the plan, execute nothing") { options[:dry_run] = true }
  o.on("--max-pushes N", Integer, "stop pushing after N total (keep ingesting)") { |v| options[:max_pushes] = v }
  o.on("--budget N", Integer, "max queued+running CI runs (default PatchCi::Config::BUDGET)") { |v| options[:budget] = v }
  o.on("--interval N", Integer, "seconds between cycles (default 60)") { |v| options[:interval] = v }
  o.on("--repo PATH", "postgres checkout (default $CI_REPO_DIR or ./postgres)") { |v| options[:repo] = v }
  o.on("--worktree PATH", "apply worktree (default $CI_WORKTREE_DIR or ./tmp/patch_ci_worktree)") { |v| options[:worktree] = v }
  o.on("--github-repo NAME", "owner/name CI runs in (default from PatchCi::Config)") { |v| options[:github_repo] = v }
  o.on("--master-ref REF", "ref that is master truth (default <upstream-remote>/master)") { |v| options[:master_ref] = v }
  o.on("--upstream-remote NAME", "remote master truth is fetched from (default postgres)") { |v| options[:upstream_remote] = v }
  o.on("--[no-]mirror-master", "fast-forward the push remote's master from upstream (default on)") { |v| options[:mirror_master] = v }
end.parse!

require_relative "../config/environment"

# rails is not loaded at optparse time, so the default lands here
options[:budget] ||= PatchCi::Config::BUDGET
options[:github_repo] ||= PatchCi::Config::GITHUB_REPO

repo = PatchBranches::GitRepo.new(options[:repo])

# a worktree left half-created by a killed process must not read as healthy
# for the rest of this process's life; see GitRepo#ensure_worktree!
repo.ensure_worktree!(options[:worktree])
worktree = PatchBranches::GitRepo.new(options[:worktree])

orchestrator = PatchCi::Orchestrator.new(
  client: PatchCi::GithubClient.new(repo: options[:github_repo]),
  pusher: PatchCi::Pusher.new(repo: repo, worktree: worktree, remote: options[:remote]),
  guard: PatchCi::PushGuard.new(repo),
  apply_one: PatchBranches::ApplyOne.new(repo: repo, worktree: worktree),
  result_refs: PatchCi::ResultRefs.new(repo, remote: options[:remote]),
  pruner: PatchCi::ResultRefPruner.new(repo, remote: options[:remote]),
  repo: repo,
  master_sync: PatchCi::MasterSync.new(repo, upstream_remote: options[:upstream_remote],
                                             push_remote: options[:remote],
                                             master_ref: options[:master_ref],
                                             mirror: options[:mirror_master]),
  budget: options[:budget],
  max_pushes: options[:max_pushes],
  dry_run: options[:dry_run]
)

def touch_heartbeat
  FileUtils.touch(HEARTBEAT_PATH)
rescue SystemCallError => e
  warn "heartbeat touch failed: #{e.message}"
end

# hourly, and never on a dry run: the import writes rows, which is exactly what
# --dry-run promises not to do. on_progress: the pass spans a fetch plus a
# full commit import - both slower than the healthcheck's stale window - so
# the heartbeat needs a touch mid-pass, not just at the start and end of a cycle.
maintenance = PatchCi::RepoMaintenance.new(repo: repo, upstream_remote: options[:upstream_remote],
                                            on_progress: method(:touch_heartbeat))

def summary_line(result)
  ingested = result[:ingested].to_a.map { |status, count| "#{status}:#{count}" }.join(",")
  rest = result.except(:ingested).map { |k, v| "#{k}=#{v}" }.join(" ")
  "[#{Time.current.iso8601}] #{rest} ingested=#{ingested.presence || '-'}"
end

def maintenance_line(maint)
  import = maint.skipped ? "skipped(lock held)" : (maint.import_error || "ok")
  "[#{Time.current.iso8601}] maintenance fetch=#{maint.fetch_error || 'ok'} import=#{import}"
end

# same key as script/patch_apply.rb: both write branch refs in the same repo
ran = AdvisoryLock.with_lock(LOCK_KEY) do
  # before the first cycle: the healthcheck reads a missing file as unhealthy,
  # and the first cycle can take a minute
  touch_heartbeat
  failures = 0
  loop do
    begin
      # the outer lock lives on one AR session and an auto-reconnect drops it
      # without a word. The nested try answers the question with teeth - has
      # somebody else taken over? - for the price of two round trips. It does
      # not re-take the lock (with_lock releases what it took), so after a
      # reconnect a competitor can win the race; then this probe fails and the
      # loser exits, which is the outcome that matters: never two of us pushing.
      abort "lost the #{LOCK_KEY} lock, another process holds it" unless AdvisoryLock.with_lock(LOCK_KEY) { true }

      # tmp/ is disposable; a worktree deleted under us turns every following
      # cycle into silent push_failed churn. One rev_parse when it is healthy.
      repo.ensure_worktree!(options[:worktree])

      unless options[:dry_run]
        maint = maintenance.call
        puts maintenance_line(maint) if maint.ran
      end

      result = orchestrator.cycle
      puts summary_line(result)
      # a cycle that caught its own error still made no progress, so it feeds
      # the same counter: an invalid token would otherwise spin here forever,
      # quietly. Per-item failures (result[:failed]) do not - partial progress
      # is progress.
      raise "poll failed, pushed nothing: #{result[:error]}" if result[:error]

      failures = 0
    rescue StandardError => e
      # transport timeouts, a dropped DB connection, an unresolvable master:
      # one of those must not end a 24h backfill. Interrupt is not a
      # StandardError, so ctrl-c still stops the loop.
      failures += 1
      warn "cycle failed (#{failures} in a row): #{e.class}: #{e.message}"
      raise if options[:once] || failures >= MAX_CONSECUTIVE_FAILURES
    end
    # liveness is "the loop is turning", success or not: a failed cycle warns
    # for itself and counts toward MAX_CONSECUTIVE_FAILURES
    touch_heartbeat
    break if options[:once]
    sleep options[:interval]
  end
  :done
end
abort "#{LOCK_KEY} lock is held, another apply or orchestrator run is active" unless ran == :done
