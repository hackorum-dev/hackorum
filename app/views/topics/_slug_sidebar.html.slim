- editable = topic.slug_editable_by?(current_user)
- current = topic.slug_in_database
- if current.present? || editable
  details.sidebar-section.slug-sidebar id=dom_id(topic, :slug_sidebar) open=true
    summary.sidebar-heading Short link
    .sidebar-section
      - if current.present?
        - url = short_topic_url(current)
        .slug-sidebar-row
          code.ci-copy title=url data-controller="clipboard" data-action="click->clipboard#copy" data-clipboard-url-value=url = "/t/#{current}"
        - image_ref = ci_status&.image_run&.image_ref
        - if image_ref.present?
          - slug_ref = "#{image_ref.rpartition(':').first}:#{current}"
          - cmd = ci_docker_command(slug_ref)
          .slug-sidebar-row
            code.ci-copy title=cmd data-controller="clipboard" data-action="click->clipboard#copy" data-clipboard-url-value=cmd = ci_docker_label(slug_ref)
      - if editable
        details.slug-sidebar-edit open=topic.errors[:slug].any?
          summary = current.present? ? "edit" : "add short link"
          = form_with model: topic, scope: :topic, url: topic_slug_path(topic), method: :patch, class: "slug-sidebar-form" do |f|
            = f.text_field :slug, placeholder: "my-feature", maxlength: 64, autocomplete: "off", spellcheck: false
            = f.submit "Save"
          - if current.present?
            = button_to "Remove", topic_slug_path(topic), method: :delete, class: "slug-sidebar-remove", form: { data: { turbo_confirm: "Remove the short link /t/#{current}?" } }
          - topic.errors.full_messages_for(:slug).each do |msg|
            .slug-sidebar-error = msg
