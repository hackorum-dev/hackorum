= turbo_stream.append "topics" do
  = render partial: "topics", locals: { topics: @topics, personalization: @personalization }

- search_params = @saved_search ? { saved_search_id: @saved_search.id, team_id: @saved_search_team&.id }.compact : { q: @search_query }

- if @topics.size == 25
  - last_topic = @topics.last
  - cursor = "#{last_topic.last_activity.iso8601(6)}_#{last_topic.id}"
  = turbo_stream.replace "pagination" do
    = turbo_frame_tag "pagination", src: search_topics_path(**search_params, cursor: cursor, viewing_since: @viewing_since.iso8601, longpage: @current_longpage, format: :turbo_stream), loading: :lazy, data: { controller: "prefetch-frame" } do
      .loading-indicator Loading more results...
- elsif params[:cursor].present?
  = turbo_stream.remove "pagination"
