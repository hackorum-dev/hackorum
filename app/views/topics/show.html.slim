- content_for :title, @topic.title

- content_for :sidebar do
  .sidebar.topic-sidebar
    = render "topics/sidebar/short_link", topic: @topic
    - if @latest_patch
      = render "topics/sidebar/patch_card", topic: @topic, ci_status: @ci_status, latest_patch: @latest_patch, message_numbers: @message_numbers, patch_stats: @latest_patchset_stats, patchset_count: @patchset_count, attachment_message_count: @attachment_message_count, lineage: @lineage
    - if ci_thread_visible?(@ci_status)
      = render "topics/sidebar/ci", status: @ci_status, topic: @topic
    - if @commitfest_summary.any?
      = render "topics/sidebar/commitfest", topic: @topic, summary: @commitfest_summary
    - if @commit_summary.any?
      = render "topics/sidebar/commits", topic: @topic, summary: @commit_summary
    = render "topics/sidebar/participants", activity: @participant_activity, topic: @topic
    - if @notes_by_message.present?
      - note_map = @notes_by_message
      - message_note_entries = note_map.keys.filter_map do |key|
        - next unless key.is_a?(Integer)
        - notes = note_map[key]
        - next if notes.blank?
        - number = @message_numbers[key]
        - next unless number
        - [key, number, notes]
      - message_note_entries = message_note_entries.sort_by { |entry| entry[1] }
      - if message_note_entries.any?
        details.sidebar-section
          summary.sidebar-heading = "Notes · #{message_note_entries.size}"
          .sidebar-section
            ul.note-overview
              - message_note_entries.each do |message_id, number, notes|
                li
                  = link_to "#message-#{message_id}", class: "note-overview-link" do
                    span.note-overview-target = "##{number}"
                    span.note-overview-count = "(#{notes.size})"
    - if user_signed_in?
      = render "topics/drafts_sidebar", drafts: @sidebar_drafts, message_numbers: @message_numbers
    = render "topics/sidebar/thread", topic: @topic, messages: @messages, message_numbers: @message_numbers, buckets: @activity_buckets, latest_patch: @latest_patch, unread_count: @unread_count

.topic-header *visited_topic_attrs(@topic)
  .topic-title-section
    .topic-title-with-star
      - if user_signed_in?
        = render "star_button", topic: @topic, starred: @is_starred
      h1 = @topic.title
    .topic-meta
      span.creator Started by #{@topic.creator_display_alias.name}
      span.date #{time_ago_in_words(@topic.created_at)} ago
      span.message-count #{@messages.size} messages
      - if @topic_mailing_lists.present?
        span.mailing-lists
          = mailing_list_badges_html(@topic_mailing_lists)
    - if current_admin?
      .admin-actions
        = link_to new_admin_topic_merge_path(@topic), class: "button button-secondary button-small" do
          i.fas.fa-compress-arrows-alt
          |  Merge Topic

- if user_signed_in? || @notes_by_message&.[](:thread).present?
  - thread_notes = @notes_by_message&.[](:thread) || []
  .thread-notes-container
    = render "notes/note_stack", topic: @topic, message: nil, notes: thread_notes

.person-nav-bar hidden=true data-controller="person-nav" data-person-nav-messages-value=@person_messages_json data-person-nav-timeline-value=timeline_topic_path(@topic) data-action="person-nav:start@window->person-nav#start turbo:before-cache@document->person-nav#stop"
  span.person-nav-text
    | Stepping through
    strong data-person-nav-target="name"
  span.person-nav-position data-person-nav-target="position"
  span.person-nav-spacer
  button.person-nav-button type="button" data-person-nav-target="prev" data-action="person-nav#prev"
  button.person-nav-button type="button" data-person-nav-target="next" data-action="person-nav#next"
  button.person-nav-button type="button" data-action="person-nav#list" List
  button.person-nav-button type="button" aria-label="Stop stepping" data-action="person-nav#stop"
    i.fa-solid.fa-xmark aria-hidden="true"

.messages-container.flat.asc data-controller="batch-loader" data-batch-loader-url-value=message_batch_topic_path(@topic) data-batch-loader-signed-in-value=(user_signed_in? ? true : false)
  - last_message = @messages.last
  - if last_message.present?
    .thread-actions data-controller="thread-actions" data-thread-actions-topic-id-value=@topic.id data-thread-actions-read-all-url-value=read_all_topic_path(@topic, format: :json) data-thread-actions-unread-all-url-value=unread_all_topic_path(@topic, format: :json)
      - if user_signed_in?
        button.button.button-secondary.button-small data-action="click->thread-actions#markAllRead" Mark all read
        button.button.button-secondary.button-small data-action="click->thread-actions#markAllUnread" Mark all unread
      button.button.button-secondary.button-small data-action="click->thread-actions#collapseAll" Collapse all
      button.button.button-secondary.button-small data-action="click->thread-actions#expandAll" Show all
      = link_to "Jump to latest", "#message-#{last_message.id}", class: "button button-secondary button-small", title: "Jump to latest message", "aria-label": "Jump to latest message"
      - if user_signed_in?
        = link_to "Jump to unread", "#first-unread", class: "button button-secondary button-small", title: "Jump to first unread message", "aria-label": "Jump to first unread message"

  - collapse_read = !user_signed_in? || current_user.collapse_read_messages?
  - first_unread_found = false
  - unread_inline_count = 0
  - @messages.each do |message|
    - is_read = user_signed_in? && @read_message_ids&.dig(message.id)
    - is_first_unread = false
    - if user_signed_in? && !is_read && !first_unread_found
      - is_first_unread = true
      - first_unread_found = true
    - if is_read
      - render_mode = :shell
    - elsif unread_inline_count < 20
      - render_mode = :inline
      - unread_inline_count += 1
    - else
      - render_mode = :shell
    - branch_index = @message_branch_index&.dig(message.id)
    = render 'message', message: message, number: @message_numbers[message.id], is_first_unread: is_first_unread, branch_index: branch_index, render_mode: render_mode, is_read: !!is_read, collapse_read: collapse_read

.topic-navigation
  = link_to "← Back to Topics", topics_path, class: "back-link"
