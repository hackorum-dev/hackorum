details.sidebar-section open=true
  summary.sidebar-heading Patch lineage
  .sidebar-section
    - if lineage.story.present?
      ul.lineage-story
        - lineage.story.lines.map(&:strip).reject(&:empty?).each do |line|
          li = lineage_text(line, lineage.ordinals)
    - lineage.verdicts.each do |v|
      .lineage-verdict
        = link_to v[:subject], commit_web_url(v[:sha]), target: "_blank", rel: "noopener", class: "commit-sidebar-link"
        .lineage-verdict-meta
          span.lineage-kind = v[:verdict]
          - if v[:change_level]
            span.lineage-change title="light = formatting, naming, comments, tests; moderate = local logic; significant = approach changed" = v[:change_level]
          - if v[:extra]
            span.lineage-extra found in git
          - if v[:source_ordinal]
            span.lineage-source = "from ##{v[:source_ordinal]}"
          span.lineage-confidence = "#{(v[:confidence] * 100).round}%"
        - if v[:reviewers_total] > 0
          details.lineage-reviews
            summary = "reviews: #{v[:reviewers_final]} of #{v[:reviewers_total]} reviewed the final version"
            ul.lineage-review-list
              - v[:reviews].each do |r|
                li
                  span.lineage-reviewer = r["reviewer"]
                  span.lineage-coverage = r["coverage"]
                  - if r["source"] == "llm"
                    span.lineage-review-llm title="Found by the patchset lineage model, not a Reviewed-by trailer" LLM
                    - if r["confidence"]
                      span.lineage-review-confidence = "#{(r["confidence"].to_f * 100).round}%"
                  - if r["source"] == "committer"
                    span.lineage-review-committer title="Committed the patch, counted as its reviewer" committer
                  - if r["note"].present?
                    span.lineage-review-note = lineage_text(r["note"], lineage.ordinals)
        - if v[:evidence].present?
          .lineage-evidence = lineage_text(v[:evidence], lineage.ordinals)
    .lineage-run-meta
      = [ "run #{lineage.run.id}", lineage.run.model, absolute_time_display(lineage.run.finished_at) ].compact_blank.join(", ")
