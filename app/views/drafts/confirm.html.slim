= turbo_frame_tag "confirm-#{@draft.id}"
  .modal-backdrop data-controller="send-confirmation" data-send-confirmation-cooldown-value="1500"
    .modal-dialog.confirm-modal role="dialog" aria-modal="true" aria-labelledby="confirm-title-#{@draft.id}"
      h2 id="confirm-title-#{@draft.id}" Confirm send
      - draft_api_labels(@draft).each do |label|
        p.confirm-via = label

      .confirm-row
        strong From
        .confirm-value = "#{@draft.sender_alias.name} <#{@draft.sender_alias.email}>"
      .confirm-row
        strong To
        .confirm-value = @recipients.to.join(", ")
      - if @recipients.cc.any?
        .confirm-row
          strong Cc
          .confirm-value = @recipients.cc.join(", ")
      .confirm-row
        strong Subject
        .confirm-value = @draft.subject
      - attachments = @draft.draft_attachments.listing.to_a
      - if attachments.any?
        .confirm-row
          strong Attachments
          ul.confirm-value.confirm-attachments
            - attachments.each do |a|
              li.confirm-attachment
                = link_to a.file_name, draft_attachment_path(@draft, a), download: a.file_name, data: { turbo: false }
                '
                span.muted = number_to_human_size(a.byte_size)
      .confirm-message
        strong Message
        pre.confirm-body = @draft.body

      - unless Rails.env.production?
        .dev-warning
          i.fa-solid.fa-flask
          |  Dev mode — sending to override address (HACKORUM_DEV_REPLY_TO).

      p.confirm-disclaimer
        | Once sent, the message will be visible to all list subscribers and cannot be unsent.

      .confirm-actions
        = button_tag "Cancel", type: "button", class: "button-secondary",
                     data: { action: "click->send-confirmation#cancel" }
        = button_to "Send to #{pluralize(@recipients.all.size, 'recipient')}", send_now_draft_path(@draft),
                    method: :post, class: "button-primary", params: { version: @draft.version },
                    data: { send_confirmation_target: "submit", disabled: true }
