- range_text = [ "Cycle: #{l(release.start.to_date)} (#{release.major - 1} branched)", release.closed? ? "to #{l(release.end_at.to_date)} (#{release.major}.0)" : "to #{release.label} GA (not yet tagged)" ].join(" ")
.stats-chips
  - releases.each do |r|
    - classes = [ "stats-chip", ("is-active" if r.major == release.major), ("is-dim" if r.in_development?) ].compact.join(" ")
    = link_to stats_release_path(r.major), class: classes do
      = r.label
      - if r.in_development?
        |  (in development)
  span.stats-range = range_text
nav.stats-tabs
  = link_to "Overview", stats_release_path(release.major), class: "stats-tab#{' is-active' if tab == :overview}"
  = link_to "Pulse", stats_release_pulse_path(release.major), class: "stats-tab#{' is-active' if tab == :pulse}"
  - if release.companies?
    = link_to "Companies", stats_release_companies_path(release.major), class: "stats-tab#{' is-active' if tab == :companies}"
  = link_to "People", stats_release_people_path(release.major), class: "stats-tab#{' is-active' if tab == :people}"
  = link_to "Committers", stats_release_committers_path(release.major), class: "stats-tab#{' is-active' if tab == :committers}"
  - if local_assigns[:person]
    span.stats-tab.is-active = person[:name]
