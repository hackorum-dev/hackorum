- p = @data[:person]
- content_for :title, "#{p[:name]} in #{@period.long_label}"
- code = @data[:code]
- disc = @data[:discussion]
- lin = @data[:lineage]
- rev = @data[:reviews]
- ww = @data[:worked_with]
- llm = @data[:llm]
- pill = ->(h, unit = "") { render "stats/periods/pill", value: h[:value], release: h[:release], better: h[:better], unit: unit, noun: @period.pill_noun }
- pill_share = ->(h) { render "stats/periods/pill", value: h[:share], release: h[:release], better: h[:better], unit: "%", noun: @period.pill_noun }
- rank = ->(h, what, none) { h[:rank] ? "##{h[:rank]} of #{h[:of]} #{what}" : none }
- started = disc[:threads_started]

.stats-page
  h1 = "#{@period.title} statistics"
  = render "stats/periods/header", period: @period, periods: @periods, tab: :person, person: p
  .stats-head
    .avatar = stats_initials(p[:name])
    div
      .n = "#{p[:name]} in #{@period.long_label}"
      .s
        = p[:committer] ? stats_committer_badge(p[:committer_since]) : "contributor"
        - if p[:company]
          | ,
          =< tag.abbr(p[:company], title: "Affiliation from public sources (the PostgreSQL contributors page, commit messages and email domains, conference and company pages, public profiles); it can be wrong or out of date. To correct or remove it, see the privacy policy linked at the bottom of the page.")
        - if p[:email]
          |  ·
          =< link_to "profile", person_path(p[:email])
          |  ·
          =< link_to "all commits", person_commits_path(p[:email])
          - @neighbours.each do |r|
            |  ·
            =< link_to r.label, stats_period_path(r, :person, p[:email])
  h2.stats-band Code
  .stats-tiles
    - if p[:committer]
      = render "stats/periods/tile", v: stats_number(code[:commits][:value]), k: "Commits", d: rank.call(code[:commits], "committers", nil)
      = render "stats/periods/tile", v: stats_number(code[:own][:value]), k: "Own", d: safe_join([ "#{code[:own][:share]}% of their commits ", pill_share.call(code[:own]) ])
      = render "stats/periods/tile", v: stats_number(code[:for_others][:value]), k: "For others", d: "from #{code[:for_others][:authors]} authors"
      = render "stats/periods/tile", v: stats_number(code[:reviewed_for_others]), k: "Reviewed for others", d: "on other committers' commits; own commits never count"
      = render "stats/periods/tile", v: stats_number(code[:reverts][:value]), k: "Reverts", d: safe_join([ "#{code[:reverts][:share]}% of their commits ", pill_share.call(code[:reverts]) ])
      = render "stats/periods/tile", v: stats_number(code[:lines][:added] + code[:lines][:removed]), k: "Lines", d: [ "+#{stats_number(code[:lines][:added])} / -#{stats_number(code[:lines][:removed])}", rank.call(code[:lines], "committers", nil) ].compact.join(", ")
    - else
      = render "stats/periods/tile", v: stats_number(code[:authored][:value]), k: "Authored", d: rank.call(code[:authored], "authors", "no commits authored")
      = render "stats/periods/tile", v: stats_number(code[:reviewed][:value]), k: "Reviewed", d: "credited in commit messages"
  h2.stats-band Discussion
  .stats-tiles
    = render "stats/periods/tile", v: stats_number(disc[:messages][:value]), k: "Messages", d: rank.call(disc[:messages], "people", "no messages in the threads that landed in #{@period.long_label}")
    = render "stats/periods/tile", v: stats_number(started[:value]), k: "Threads started", d: "in the #{@period.noun}"
    = render "stats/periods/tile", v: stats_number(started[:landed]), k: "Of those landed in #{@period.long_label}", d: (started[:value].positive? ? safe_join([ "#{started[:landed_share]}% ", pill.call(started.merge(value: started[:landed_share]), "%") ]) : nil)
    - if @period.branch_point
      = render "stats/periods/tile", v: stats_number(disc[:started_after_branch][:value]), k: "Started after the #{@period.major} branch point", d: "#{disc[:started_after_branch][:landed]} landed in #{@period.long_label}"
    = render "stats/periods/tile", v: stats_number(disc[:people_talked_to][:value]), k: "People talked to", d: "replied to or replied by; #{disc[:people_talked_to][:committers]} committers, #{disc[:people_talked_to][:others]} others"
    = render "stats/periods/tile", v: "#{disc[:thread_age][:value]} d", k: "Thread age at commit", d: safe_join([ "median ", pill.call(disc[:thread_age], " d") ]), na: disc[:thread_age][:value].nil?
    - if llm
      = render "stats/periods/tile", v: disc[:versions][:value], k: "Versions per patch", d: safe_join([ "patches they #{p[:committer] ? 'committed' : 'authored'} ", pill.call(disc[:versions]) ]), na: disc[:versions][:value].nil?
    = render "stats/periods/tile", v: "#{disc[:cf_share][:value]}%", k: "Commits with a Commitfest entry", d: safe_join([ "#{disc[:cf_share][:count]} of #{disc[:cf_share][:of]} ", pill.call(disc[:cf_share], "%") ]), na: disc[:cf_share][:of].zero?
  - if llm
    h2.stats-band = p[:committer] ? "Patches they committed for others" : "Their patches"
    .stats-tiles
      = render "stats/periods/tile", kind: "share", v: "How the posted patch became the commit", na: lin[:of].zero?, chart: [ "share", { segments: stats_share_segments([ [ "as posted", lin[:verdicts][:as_is], nil ], [ "split from a series", lin[:verdicts][:partial], nil ], [ "modified", lin[:verdicts][:modified], nil ], [ "from discussion", lin[:verdicts][:from_discussion], nil, true ] ]) } ]
      = render "stats/periods/tile", kind: "share", v: "How much the committer changed it", na: lin[:verdicts][:modified].zero?, chart: [ "share", { segments: stats_share_segments([ [ "light", lin[:change_levels][:light], nil ], [ "moderate", lin[:change_levels][:moderate], nil ], [ "significant", lin[:change_levels][:significant], nil ] ]) } ]
  h2.stats-band = p[:committer] ? "Reviews of their commits" : "Reviews of their patches"
  .stats-tiles
    = render "stats/periods/tile", v: "#{rev[:crediting][:value]}%", k: "Crediting a reviewer", d: safe_join([ "#{rev[:crediting][:count]} of #{rev[:crediting][:of]} ", pill.call(rev[:crediting], "%") ]), na: rev[:crediting][:of].zero?
    - if llm
      = render "stats/periods/tile", kind: "share", v: "What the credited reviewers saw", na: rev[:coverage].values.sum.zero?, chart: [ "share", { segments: stats_share_segments([ [ "final version", rev[:coverage][:final], nil ], [ "earlier version only", rev[:coverage][:earlier], nil ], [ "not found in the thread", rev[:coverage][:none], nil, true ] ]) } ]
    - if llm && rev[:alone]
      = render "stats/periods/tile", v: "#{rev[:alone][:value]}%", k: tag.abbr("Sole reviewer of others' patches", title: "Of the others' patches they committed that the LLM assessed: no reviewer credited or found besides themselves"), d: safe_join([ "#{rev[:alone][:count]} of #{rev[:alone][:of]} ", pill.call(rev[:alone], "%") ]), na: rev[:alone][:of].zero?
    = render "stats/periods/tile", v: rev[:per_commit][:value], k: "Reviewers per reviewed commit", d: pill.call(rev[:per_commit]), na: rev[:crediting][:count].zero?
  h2.stats-band Worked with
  .stats-three
    - if p[:committer]
      = render "stats/periods/worked_with", period: @period, title: "Committed for", sub: "patches from #{ww[:committed_for][:top].size + ww[:committed_for][:rest][:people]} authors", data: ww[:committed_for]
    - else
      = render "stats/periods/worked_with", period: @period, title: "Committed by", sub: "committers who landed their patches", data: ww[:committed_by]
    = render "stats/periods/worked_with", period: @period, title: "Reviewed by", sub: "credited on their #{p[:committer] ? 'commits' : 'patches'}", data: ww[:reviewed_by]
    = render "stats/periods/worked_with", period: @period, title: "Reviewed", sub: (p[:committer] ? "credits on other committers' commits" : "credits on committers' commits"), data: ww[:reviewed]
  h2.stats-band Pulse
  .stats-strips-card style="--stats-strips-height: #{60 + @data[:pulse][:strips].size * 125}px"
    = stats_chart("strips", @data[:pulse], css_class: "stats-chart stats-strips", label: "#{p[:name]} pulse")
  = render "stats/footer"
