- content_for :title, "Admin — New Mailbox"

.settings-page
  h1 New Mailbox

  = form_with scope: :mailbox, url: admin_mailboxes_path, method: :post, local: true do |f|
    - if @errors.any?
      .flash-alert
        ul
          - @errors.each do |msg|
            li = msg

    .form-group
      = f.label :username
      = f.text_field :username, value: @form[:username], required: true, class: "form-input"

    .form-group
      = f.label :login
      = f.text_field :login, value: @form[:login], class: "form-input"
      small.form-hint Defaults to the username. Cannot be changed later.

    .form-group
      = f.label :quota_mb, "Quota (MB)"
      = f.number_field :quota_mb, value: @form[:quota_mb], placeholder: Mailbox::DEFAULT_QUOTA_MB, class: "form-input"

    = f.submit "Create", class: "button-primary"
