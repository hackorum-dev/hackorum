- content_for :title, "Admin — #{@label}"

.settings-page
  h1 = @label

  p = link_to "Back to features", admin_features_path, class: "button-secondary"

  .settings-section
    h2 Add user
    = form_with url: admin_feature_enrollments_path(@feature), method: :post, local: true, class: "email-form", data: { turbo: false } do |f|
      .form-group
        = f.label :identifier, "Username or email"
        = f.text_field :identifier, required: true, placeholder: "alice or alice@example.com"
      = f.submit "Enroll", class: "button-primary"

  .settings-section
    h2 Enable for team
    = form_with url: admin_feature_team_enrollments_path(@feature), method: :post, local: true, class: "email-form", data: { turbo: false } do |f|
      .form-group
        = f.label :team_name, "Team name"
        = f.text_field :team_name, required: true
      = f.submit "Enable", class: "button-primary"

  .settings-section
    h2 Teams
    - if @teams.any?
      table.email-table
        thead
          tr
            th Team
            th Members
            th
        tbody
          - @teams.each do |t|
            tr
              td = t.name
              td = t.member_count
              td
                = button_to "Remove", admin_feature_team_enrollment_path(@feature, t), method: :delete, data: { turbo_confirm: "Remove for all members of #{t.name}?" }, class: "button-danger button-small"
    - else
      p No teams enrolled.

  .settings-section
    h2 Users with access
    - if @users.any?
      table.email-table
        thead
          tr
            th Username
            th Email
            th Source
            th
        tbody
          - @users.each do |u|
            - src = @access[u.id]
            tr
              td = u.username || "—"
              td = u.person&.default_alias&.email || "—"
              td = ([ ("direct" if src[:direct]) ] + src[:teams].map { |t| "via #{t}" }).compact.join(", ")
              td
                - if src[:direct]
                  = button_to "Remove", admin_feature_enrollment_path(@feature, u), method: :delete, data: { turbo_confirm: "Remove enrollment?" }, class: "button-danger button-small"
    - else
      p No users have access yet.
