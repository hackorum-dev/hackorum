- content_for :title, "Admin — Edit Feature Group"

.settings-page
  h1 Edit Feature Group

  = form_with model: @group, url: admin_feature_group_path(@group), method: :patch, local: true do |f|
    - if @group.errors.any?
      .flash-alert
        ul
          - @group.errors.full_messages.each do |msg|
            li = msg

    .form-group
      = f.label :name
      = f.text_field :name, required: true, class: "form-input"

    .form-group
      = f.label :slug
      = f.text_field :slug, class: "form-input"

    .form-group
      = f.label :summary
      = f.text_area :summary, rows: 4, class: "form-input"

    = f.submit "Save", class: "button-primary"
