{#- every value shell-quoted: read by `. restic.env` and by systemd EnvironmentFile alike -#}
RESTIC_REPOSITORY={{ 'sftp:storagebox:hackorum-restic' | quote }}
RESTIC_PASSWORD={{ restic_password | quote }}
RESTIC_CACHE_DIR={{ (bulk_root ~ '/restic-cache') | quote }}
HACKORUM_ROOT={{ hackorum_root | quote }}
HACKORUM_DUMPS_ROOT={{ hackorum_dumps_root | quote }}
PLATFORM_ROOT={{ platform_root | quote }}
HEALTHCHECKS_BACKUP_URL={{ healthchecks_backup_url | quote }}
HEALTHCHECKS_RESTORE_URL={{ healthchecks_restore_url | quote }}
HEALTHCHECKS_MONTHLY_URL={{ healthchecks_monthly_url | quote }}
MAIL_DOMAIN={{ mail_domain | quote }}
RECEIVER_USER={{ receiver_user | quote }}
ENV_NAME={{ env_name | quote }}
BACKUP_SOURCE_HOST={{ backup_source_host | default('') | quote }}
