{#- compose dotenv, double quoted: \ " $ and newlines escaped, value stays literal -#}
{%- macro q(v) -%}
"{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\n', '\\n') }}"
{%- endmacro -%}
{%- macro u(v) -%}
{{ v | string | urlencode | replace('/', '%2F') }}
{%- endmacro -%}
# rendered by ansible, do not edit on the host
APP_IMAGE={{ app_image }}
IMAGE_TAG={{ image_tag }}
RAILS_ENV=production
HACKORUM_ENV={{ 'staging' if env_name == 'staging' else 'production' }}
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1
RAILS_MASTER_KEY={{ q(rails_master_key) }}
SECRET_KEY_BASE={{ q(secret_key_base) }}
WEB_CONCURRENCY={{ puma_workers }}
RAILS_MAX_THREADS={{ puma_threads }}
JOB_CONCURRENCY={{ job_concurrency }}
METRICS_ENABLED=1

POSTGRES_PASSWORD={{ q(postgres_password) }}
HACKORUM_DATABASE_PASSWORD={{ q(postgres_password) }}
DATABASE_URL={{ q('postgresql://hackorum:' ~ u(postgres_password) ~ '@db:5432/hackorum') }}
PGHOST=db
PGPORT=5432
PGUSER=hackorum
PGPASSWORD={{ q(postgres_password) }}
PGDATABASE=hackorum

APP_HOST={{ app_host }}
FORCE_SSL={{ 'false' if env_name == 'ci' else 'true' }}

# transactional mail through the local mailserver (cert is for mail_host, so use that name)
MAIL_DOMAIN={{ mail_domain }}
MAIL_HOST={{ mail_host }}
{% if webmail_host is defined %}
WEBMAIL_HOST={{ webmail_host }}
{% endif %}
DMS_CONFIG_DIR=/dms-config
MAIL_FROM=noreply@{{ mail_domain }}
SMTP_ADDRESS={{ mail_host }}
SMTP_PORT=587
SMTP_DOMAIN={{ mail_domain }}
SMTP_USERNAME={{ app_smtp_user }}@{{ mail_domain }}
SMTP_PASSWORD={{ q(app_smtp_password) }}
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=always
SMTP_OPENSSL_VERIFY=peer
HACKORUM_OUTGOING_DOMAIN={{ mail_domain }}

RECEIVER_PASSWORD={{ q(receiver_password) }}
ROUNDCUBE_DES_KEY={{ q(roundcube_des_key) }}

GOOGLE_CLIENT_ID={{ q(google_client_id) }}
GOOGLE_CLIENT_SECRET={{ q(google_client_secret) }}
GOOGLE_REDIRECT_URI=https://{{ app_host }}/auth/google_oauth2/callback

UMAMI_DB_PASSWORD={{ q(umami_db_password) }}
UMAMI_DATABASE_URL={{ q('postgresql://umami:' ~ u(umami_db_password) ~ '@db:5432/umami') }}
UMAMI_APP_SECRET={{ q(umami_app_secret) }}
UMAMI_HASH_SALT={{ q(umami_hash_salt) }}
{% if umami_host is defined and umami_website_id | length > 0 %}
UMAMI_WEBSITE_ID={{ q(umami_website_id) }}
UMAMI_HOST=https://{{ umami_host }}
{% endif %}
{% if lineage_api_token | length > 0 %}
LINEAGE_API_TOKEN={{ q(lineage_api_token) }}
{% endif %}
{% if env_name == 'ci' %}

RAILS_AR_ENCRYPTION_PRIMARY_KEY={{ ci_ar_primary_key }}
RAILS_AR_ENCRYPTION_DETERMINISTIC_KEY={{ ci_ar_deterministic_key }}
RAILS_AR_ENCRYPTION_SALT={{ ci_ar_salt }}
{% endif %}
{% if env_name == 'staging' %}

STAGING_MAIL_ALLOWLIST={{ q(staging_mail_allowlist) }}
STAGING_MAIL_SINK_HOST=mailpit
STAGING_MAIL_SINK_PORT=1025
# thread replies still go out via the Gmail API (until phase A); on staging the
# recipient resolver takes the dev-override branch, so every reply goes here
HACKORUM_DEV_REPLY_TO={{ q(staging_reply_override) }}
{% endif %}
{% if orchestrator_enabled %}

HACKORUM_GITHUB_TOKEN={{ q(hackorum_github_token) }}
{% endif %}
