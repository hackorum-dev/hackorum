OVERRIDE_HOSTNAME={{ mail_host }}
POSTMASTER_ADDRESS=postmaster@{{ mail_domain }}
# Rspamd is the spam engine. PostgreSQL list mail is allowlisted (SPF-gated) in
# rspamd/override.d/multimap.conf. Greylisting off: list mail must not be delayed.
ENABLE_RSPAMD=1
ENABLE_RSPAMD_VALKEY=1
RSPAMD_GREYLISTING=0
# DMS default 10 MB bounces big patch mails. Below rspamd max_message (50 MiB) so all mail is scanned.
POSTFIX_MESSAGE_SIZE_LIMIT=50000000
# legacy amavis/SpamAssassin/opendkim/opendmarc/policyd stack stays off (rspamd covers it)
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_POSTGREY=0
ENABLE_AMAVIS=0
ENABLE_SRS=0
# a login sends only as its own addresses; the app account is exempt (postfix-main.cf, from_owner.lua)
SPOOF_PROTECTION=1
PERMIT_DOCKER=none
# bans by client address; private ranges are ignored (fail2ban-jail.cf)
ENABLE_FAIL2BAN={{ 1 if mail_fail2ban_enabled | bool else 0 }}
# cert Caddy manages for {{ mail_host }} (platform Caddyfile pins the issuer to Let's Encrypt)
SSL_TYPE=manual
SSL_CERT_PATH={{ hackorum_mail_cert_dir }}/{{ mail_host }}.crt
SSL_KEY_PATH={{ hackorum_mail_cert_dir }}/{{ mail_host }}.key
LOG_LEVEL=info
